        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動重試。若網路中斷，請先核實伺服器結果，再手動重試，避免重複。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No automatic retry. After interruption, verify server state before retrying to avoid duplicates."
          }
        }
