    "content.irreversible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone. A failed or interrupted request may have reached the server; refresh before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销。请求失败或中断时服务器可能已经处理，请刷新核实后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤銷。請求失敗或中斷時伺服器可能已經處理，請重新整理核實後再試。"
          }
        }
      }
    },
